# PolyMarket BTC 5-Min Trading Bot — Environment Variables
# Copy this to .env and fill in your values

# ---- PolyMarket Credentials ----
# Export from polymarket.com → Cash → ⋯ → Export Private Key (remove 0x prefix)
POLYMARKET_PRIVATE_KEY=your_private_key_without_0x_prefix
POLYMARKET_WALLET_ADDRESS=0xYourWalletAddress

# API keys (auto-derived from private key on first run — copy printed values here)
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# ---- Risk Controls ----
MAX_BET_USDC=10.0          # Max USDC per trade
DRY_RUN=true               # Set to false for live trading

# ---- Optional Overrides ----
# MIN_EDGE_THRESHOLD=0.05  # Minimum edge required to place a bet (default 5%)
# MIN_CONFIDENCE=0.60      # Minimum signal confidence (default 60%)
